{
	"name": "tasks-board",
	"version": "0.1.5",
	"description": "Kanban boards over your Obsidian Tasks.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@testing-library/preact": "^3.2.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^30.0.1",
		"obsidian": "latest",
		"prettier": "^3.9.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"chrono-node": "^2.10.1",
		"preact": "^10.29.8",
		"yaml": "^2.9.0"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
